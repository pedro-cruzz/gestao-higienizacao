DJANGO_DEBUG=False
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria-com-mais-de-50-caracteres

# Render
DJANGO_ALLOWED_HOSTS=seu-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-app.onrender.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Neon/PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host.neon.tech:5432/banco?sslmode=require

# Cloudinary para imagens do catálogo
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CATALOG_FOLDER=higiflow/catalogo

# Primeiro acesso criado pelo build.sh via setup_access_groups
HIGIFLOW_DEV_USERNAME=dev
HIGIFLOW_DEV_PASSWORD=troque-por-uma-senha-forte
HIGIFLOW_DEV_EMAIL=dev@suaempresa.com.br

# Email real para recuperacao de senha
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.seuprovedor.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=usuario-smtp
EMAIL_HOST_PASSWORD=senha-smtp
DEFAULT_FROM_EMAIL=HigiFlow <nao-responda@suaempresa.com.br>
